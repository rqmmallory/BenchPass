# Supabase — project URL + keys (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — billing only (subscriptions + Customer Portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SOLO_PRICE_ID=
STRIPE_SHOP_PRICE_ID=
STRIPE_PORTAL_RETURN_URL=

# Twilio — outbound customer SMS (A2P 10DLC)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Resend — transactional email fallback
RESEND_API_KEY=

# Claude API — note cleanup + message drafts
ANTHROPIC_API_KEY=

# Sentry — error monitoring (leave empty to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_BASE_URL=

# Secret shared with the Vercel cron job that sends trial-reminder emails
CRON_SECRET=
